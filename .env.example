# Frontend: public key, safe to embed in the browser build.
VITE_CLERK_PUBLISHABLE_KEY=

# Server only: configure in Vercel settings (never prefix secrets with VITE_).
CLERK_SECRET_KEY=
WHOP_COMPANY_API_KEY=
WHOP_WEBHOOK_SECRET=
WHOP_PRODUCT_ID=

# The four distinct subscription plans; leave launch renewal prices unchanged.
WHOP_MONTHLY_LAUNCH_PLAN_ID=
WHOP_ANNUAL_LAUNCH_PLAN_ID=
WHOP_MONTHLY_REGULAR_PLAN_ID=
WHOP_ANNUAL_REGULAR_PLAN_ID=

# true on sandbox; false in live payments.
WHOP_SANDBOX=true
APP_URL=https://quimica.sistemazenit.com
